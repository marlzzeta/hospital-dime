# =============================================================================
# Hospital DIME – Variables de Entorno
# Copiar este archivo a .env.local y completar los valores reales
# NUNCA commitear .env.local al repositorio
# =============================================================================

# --- Base de Datos (Vercel Postgres / Neon) ---
# Obtener desde: https://vercel.com/dashboard > Storage > Postgres > Connect
DATABASE_URI=postgresql://USER:PASSWORD@HOST:5432/hospital_dime?sslmode=require

# --- Payload CMS ---
# Clave secreta para firmar tokens de sesión (mín. 32 chars, generar con: openssl rand -hex 32)
PAYLOAD_SECRET=change_me_use_openssl_rand_hex_32

# --- Next.js ---
# URL pública del sitio (sin trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Google reCAPTCHA v3 ---
# Obtener desde: https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# --- Vercel (solo producción, Vercel las inyecta automáticamente) ---
# VERCEL_URL se inyecta sola; no es necesario definirla aquí
